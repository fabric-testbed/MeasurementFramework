# Combined docker-compose for fabric_experiment services
# Edit or provide environment variables (.env) to customize paths/ports before running.
# Common env vars:
#  INSTALL_NAME, BASE_INSTALL_DIR, BASE_DATA_DIR, PROMETHEUS_RETENTION_TIME
#  PROMETHEUS_PORT, GRAFANA_PORT, BLACKBOX_PORT, SNMP_EXPORTER_PORT,
#  GRAFANA_USER_NAME, GRAFANA_GROUP_NAME, PROM_USER_UID, PROM_USER_GID

networks:
  "{{docker_network_name}}":
    external: true



services:

# ################################# PROMETHEUS ################################
  prometheus:
    image: prom/prometheus:v2.33.4
    container_name: "{{ install_name }}-fabric-prometheus"
    networks:
      - "{{docker_network_name}}"
    user: "{{prom_user_uid}}:{{prom_user_gid}}"
    volumes:
      - "{{ base_install_dir }}/prometheus/config:/etc/prometheus/config:ro"
      - "{{ base_install_dir }}/prometheus/secrets:/etc/prometheus/secrets:ro"
      - "{{ base_data_dir }}/prometheus:/prometheus"
    command:
      - "--config.file=/etc/prometheus/config/prometheus_config.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.max-block-duration=2h"
      - "--storage.tsdb.min-block-duration=2h"
      - "--storage.tsdb.retention.time={{prometheus_retention_time | default("15d")}}"
      - "--web.enable-lifecycle"
      - "--web.console.libraries=/usr/share/prometheus/console_libraries"
      - "--web.console.templates=/usr/share/prometheus/consoles"
      - "--web.enable-admin-api"
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "1024m"
    
 # ############################### GRAFANA ##################################
  grafana:
    image: grafana/grafana:9.1.2
    container_name: "{{ install_name }}-fabric-grafana"
    networks:
      - "{{docker_network_name}}"
    user: "{{ grafana_user_id }}:0"
    volumes:
      - "{{ base_data_dir }}/grafana/data:/var/lib/grafana"
      - "{{ base_install_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro"
      - "{{ base_install_dir }}/grafana/plugins:/var/lib/grafana/plugins"
      - "{{ base_install_dir }}/grafana/custom:/etc/grafana/custom:ro"

      # Map the node certs for CiLogon TLS in  custom.ini.
      - "{{ grafana_cert }}:/etc/grafana/certs/cert:ro"
      - "{{ grafana_key }}:/etc/grafana/certs/key:ro"

    env_file: "{{ base_install_dir }}/grafana/env_file"
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "1024m"


 # ########################### GRAFANA_RENDERER #############################
  grafana_renderer:
    image: grafana/grafana-image-renderer:3.6.1
    container_name: "{{ install_name }}-fabric-grafana_renderer"
    networks:
      - "{{docker_network_name}}"
    user: "{{ grafana_user_id }}:0"
    environment:
      # Hard coded token OK here since this is only used between 2 docker containers without outside exposure
      # Value is also set in grafana_custom.ini.j2 as renderer_token
      AUTH_TOKEN:  {{ grafana_renderer_auth_token }}
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "1024m"

 # ################################### NGINX ################################
  nginx:
    image: nginx:1.19
    container_name: "{{ install_name }}-fabric-nginx"
    networks:
      - "{{docker_network_name}}"
    volumes:
      - "{{ base_install_dir }}/nginx/config/nginx.conf:/etc/nginx/nginx.conf:ro"
      - "{{ base_install_dir }}/nginx/config/htpasswd:/etc/nginx/htpasswd:ro"
      - "{{ base_install_dir }}/nginx/config/ssl_snippet.conf:/etc/nginx/ssl_snippet.conf:ro"

      - "{{ base_install_dir }}/nginx/conf.d:/etc/nginx/conf.d:ro"

      # Certs
      - "{{ nginx_interm_cert }}:/etc/nginx/root_CA_cert_plus_intermediates_file:ro"
      - "{{ nginx_key }}:/etc/nginx/key_file:ro"
      - "{{ nginx_cert }}:/etc/nginx/cert_file:ro"
    ports: {{ nginx_ip_ports }}
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "1024m"

 # ################################# BLACKBOX ################################
  blackbox:
    image: prom/blackbox-exporter:latest
    container_name: "{{ install_name }}-fabric-blackbox"
    networks:
      - "{{docker_network_name}}"
    volumes:
      - "{{ base_install_dir }}/blackbox/config:/config:ro"
    command: ["--config.file=/config/blackbox.yml"]
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "1024m"



 # ########################### DOCKER_EXPORTER #############################
  docker_exporter:
    image: prometheusnet/docker_exporter:latest
    container_name: "{{ install_name }}-fabric-docker_exporter"
    networks:
      - "{{docker_network_name}}"
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
    restart: always
    logging:
      driver: json-file
      options:
        max-size: "1024m"

